<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Calculator.Linux.Common;assembly=Calculator.Linux"
        x:Class="Calculator.Linux.MainWindow"
        Title="Calculator" Width="980" Height="640" MinWidth="640" MinHeight="480">
  <Window.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Equals}" />
    <KeyBinding Gesture="Escape" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Clear}" />
    <KeyBinding Gesture="Back" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Backspace}" />
    <KeyBinding Gesture="Delete" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.ClearEntry}" />
    <KeyBinding Gesture="D0" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Zero}" />
    <KeyBinding Gesture="D1" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.One}" />
    <KeyBinding Gesture="D2" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Two}" />
    <KeyBinding Gesture="D3" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Three}" />
    <KeyBinding Gesture="D4" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Four}" />
    <KeyBinding Gesture="D5" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Five}" />
    <KeyBinding Gesture="D6" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Six}" />
    <KeyBinding Gesture="D7" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Seven}" />
    <KeyBinding Gesture="D8" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Eight}" />
    <KeyBinding Gesture="D9" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Nine}" />
    <KeyBinding Gesture="NumPad0" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Zero}" />
    <KeyBinding Gesture="NumPad1" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.One}" />
    <KeyBinding Gesture="NumPad2" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Two}" />
    <KeyBinding Gesture="NumPad3" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Three}" />
    <KeyBinding Gesture="NumPad4" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Four}" />
    <KeyBinding Gesture="NumPad5" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Five}" />
    <KeyBinding Gesture="NumPad6" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Six}" />
    <KeyBinding Gesture="NumPad7" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Seven}" />
    <KeyBinding Gesture="NumPad8" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Eight}" />
    <KeyBinding Gesture="NumPad9" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Nine}" />
    <KeyBinding Gesture="OemPlus" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Add}" />
    <KeyBinding Gesture="OemMinus" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Subtract}" />
    <KeyBinding Gesture="Multiply" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Multiply}" />
    <KeyBinding Gesture="Divide" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Divide}" />
    <KeyBinding Gesture="OemComma" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Decimal}" />
    <KeyBinding Gesture="Decimal" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Decimal}" />
    <KeyBinding Gesture="OemOpenBrackets" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.OpenParenthesis}" />
    <KeyBinding Gesture="OemCloseBrackets" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.CloseParenthesis}" />
    <KeyBinding Gesture="D5+Shift" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Percent}" />
    <KeyBinding Gesture="D6+Shift" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.XPowerY}" />
    <KeyBinding Gesture="F9" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Negate}" />
  </Window.KeyBindings>

  <DockPanel LastChildFill="True">
    <!-- Mode navigation -->
    <ListBox DockPanel.Dock="Left" Width="150" SelectionChanged="ModeList_SelectionChanged" Name="ModeList">
      <ListBoxItem Content="Standard" Tag="Standard" IsSelected="True" />
      <ListBoxItem Content="Scientific" Tag="Scientific" />
      <ListBoxItem Content="Programmer" Tag="Programmer" />
      <ListBoxItem Content="Date calculation" Tag="Date" />
      <ListBoxItem Content="Currency" Tag="Currency" />
      <ListBoxItem Content="Volume" Tag="Volume" />
      <ListBoxItem Content="Length" Tag="Length" />
      <ListBoxItem Content="Weight and Mass" Tag="Weight" />
      <ListBoxItem Content="Temperature" Tag="Temperature" />
      <ListBoxItem Content="Energy" Tag="Energy" />
      <ListBoxItem Content="Area" Tag="Area" />
      <ListBoxItem Content="Speed" Tag="Speed" />
      <ListBoxItem Content="Time" Tag="Time" />
      <ListBoxItem Content="Power" Tag="Power" />
      <ListBoxItem Content="Data" Tag="Data" />
      <ListBoxItem Content="Pressure" Tag="Pressure" />
      <ListBoxItem Content="Angle" Tag="Angle" />
    </ListBox>

    <!-- History / Memory dock -->
    <TabControl DockPanel.Dock="Right" Width="270" Name="SidePanel">
      <TabItem Header="History">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Bottom" Content="Clear history" Command="{Binding HistoryVM.ClearCommand}" HorizontalAlignment="Stretch" Margin="4" />
          <ListBox ItemsSource="{Binding HistoryVM.Items}" DoubleTapped="HistoryList_DoubleTapped" Name="HistoryList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Expression}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Result}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Memory">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Bottom" Content="Clear all" Command="{Binding ClearMemoryCommand}" HorizontalAlignment="Stretch" Margin="4" />
          <ListBox ItemsSource="{Binding MemorizedNumbers}" Name="MemoryList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="MC" Click="MemoryItem_Clear" FontSize="11" Margin="0,0,4,0" />
                    <Button Content="MR" Click="MemoryItem_Recall" FontSize="11" Margin="0,0,4,0" />
                    <Button Content="M+" Click="MemoryItem_Add" FontSize="11" Margin="0,0,4,0" />
                    <Button Content="M–" Click="MemoryItem_Subtract" FontSize="11" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- Calculator -->
    <DockPanel LastChildFill="True" Margin="8" Name="CalculatorPanel">
      <StackPanel DockPanel.Dock="Top">
        <ItemsControl ItemsSource="{Binding ExpressionTokens}" Height="28">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Token}" FontSize="16" Opacity="0.7" Margin="2,0" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Text="{Binding DisplayValue}" IsReadOnly="True" FontSize="44" FontWeight="Bold"
                 TextAlignment="Right" BorderThickness="0" Background="Transparent" Name="DisplayBox" />
      </StackPanel>

      <!-- Memory row -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
        <Button Content="MC" Command="{Binding ClearMemoryCommand}" Width="52" />
        <Button Content="MR" Click="MemoryRow_Recall" Width="52" />
        <Button Content="M+" Click="MemoryRow_Add" Width="52" />
        <Button Content="M–" Click="MemoryRow_Subtract" Width="52" />
        <Button Content="MS" Click="MemoryRow_Store" Width="52" />
      </StackPanel>

      <!-- Standard panel -->
      <Grid IsVisible="{Binding IsStandard}" RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="*,*,*,*">
        <Button Grid.Row="0" Grid.Column="0" Content="%" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Percent}" />
        <Button Grid.Row="0" Grid.Column="1" Content="CE" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.ClearEntry}" />
        <Button Grid.Row="0" Grid.Column="2" Content="C" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Clear}" />
        <Button Grid.Row="0" Grid.Column="3" Content="⌫" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Backspace}" />
        <Button Grid.Row="1" Grid.Column="0" Content="1/x" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Invert}" IsEnabled="{Binding IsUnaryOperatorEnabled}" />
        <Button Grid.Row="1" Grid.Column="1" Content="x²" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.XPower2}" IsEnabled="{Binding IsUnaryOperatorEnabled}" />
        <Button Grid.Row="1" Grid.Column="2" Content="√" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Sqrt}" IsEnabled="{Binding IsUnaryOperatorEnabled}" />
        <Button Grid.Row="1" Grid.Column="3" Content="÷" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Divide}" IsEnabled="{Binding IsBinaryOperatorEnabled}" />
        <Button Grid.Row="2" Grid.Column="0" Content="7" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Seven}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="2" Grid.Column="1" Content="8" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Eight}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="2" Grid.Column="2" Content="9" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Nine}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="2" Grid.Column="3" Content="×" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Multiply}" IsEnabled="{Binding IsBinaryOperatorEnabled}" />
        <Button Grid.Row="3" Grid.Column="0" Content="4" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Four}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="3" Grid.Column="1" Content="5" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Five}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="3" Grid.Column="2" Content="6" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Six}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="3" Grid.Column="3" Content="−" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Subtract}" IsEnabled="{Binding IsBinaryOperatorEnabled}" />
        <Button Grid.Row="4" Grid.Column="0" Content="1" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.One}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="4" Grid.Column="1" Content="2" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Two}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="4" Grid.Column="2" Content="3" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Three}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="4" Grid.Column="3" Content="+" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Add}" IsEnabled="{Binding IsBinaryOperatorEnabled}" />
        <Button Grid.Row="5" Grid.Column="0" Content="±" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Negate}" IsEnabled="{Binding IsNegateEnabled}" />
        <Button Grid.Row="5" Grid.Column="1" Content="0" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Zero}" IsEnabled="{Binding IsOperandEnabled}" />
        <Button Grid.Row="5" Grid.Column="2" Content="." Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Decimal}" IsEnabled="{Binding IsDecimalEnabled}" />
        <Button Grid.Row="5" Grid.Column="3" Content="=" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Equals}" />
      </Grid>

      <!-- Scientific panel -->
      <DockPanel IsVisible="{Binding IsScientific}" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
          <RadioButton Content="DEG" GroupName="Angle" Name="AngleDeg" Click="Angle_Click" Margin="0,0,8,0" />
          <RadioButton Content="RAD" GroupName="Angle" Name="AngleRad" Click="Angle_Click" Margin="0,0,8,0" />
          <RadioButton Content="GRAD" GroupName="Angle" Name="AngleGrad" Click="Angle_Click" Margin="0,0,8,0" />
          <ToggleButton Content="F-E" IsChecked="{Binding IsFToEChecked, Mode=TwoWay}" IsEnabled="{Binding IsFToEEnabled}" Margin="8,0,0,0" />
        </StackPanel>
        <Grid RowDefinitions="*,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*">
          <Button Grid.Row="0" Grid.Column="0" Content="(" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.OpenParenthesis}" />
          <Button Grid.Row="0" Grid.Column="1" Content=")" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.CloseParenthesis}" />
          <Button Grid.Row="0" Grid.Column="2" Content="π" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Pi}" />
          <Button Grid.Row="0" Grid.Column="3" Content="!" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Factorial}" />
          <Button Grid.Row="0" Grid.Column="4" Content="⌫" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Backspace}" />
          <Button Grid.Row="1" Grid.Column="0" Content="sin" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Sin}" />
          <Button Grid.Row="1" Grid.Column="1" Content="cos" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Cos}" />
          <Button Grid.Row="1" Grid.Column="2" Content="tan" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Tan}" />
          <Button Grid.Row="1" Grid.Column="3" Content="ln" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.LogBaseE}" />
          <Button Grid.Row="1" Grid.Column="4" Content="log" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.LogBase10}" />
          <Button Grid.Row="2" Grid.Column="0" Content="sin⁻¹" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.InvSin}" />
          <Button Grid.Row="2" Grid.Column="1" Content="cos⁻¹" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.InvCos}" />
          <Button Grid.Row="2" Grid.Column="2" Content="tan⁻¹" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.InvTan}" />
          <Button Grid.Row="2" Grid.Column="3" Content="eˣ" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.EPowerX}" />
          <Button Grid.Row="2" Grid.Column="4" Content="10ˣ" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.TenPowerX}" />
          <Button Grid.Row="3" Grid.Column="0" Content="sinh" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Sinh}" />
          <Button Grid.Row="3" Grid.Column="1" Content="cosh" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Cosh}" />
          <Button Grid.Row="3" Grid.Column="2" Content="tanh" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Tanh}" />
          <Button Grid.Row="3" Grid.Column="3" Content="xʸ" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.XPowerY}" />
          <Button Grid.Row="3" Grid.Column="4" Content="ʸ√x" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.YRootX}" />
          <Button Grid.Row="4" Grid.Column="0" Content="7" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Seven}" />
          <Button Grid.Row="4" Grid.Column="1" Content="8" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Eight}" />
          <Button Grid.Row="4" Grid.Column="2" Content="9" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Nine}" />
          <Button Grid.Row="4" Grid.Column="3" Content="÷" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Divide}" />
          <Button Grid.Row="4" Grid.Column="4" Content="Mod" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Mod}" />
          <Button Grid.Row="5" Grid.Column="0" Content="4" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Four}" />
          <Button Grid.Row="5" Grid.Column="1" Content="5" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Five}" />
          <Button Grid.Row="5" Grid.Column="2" Content="6" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Six}" />
          <Button Grid.Row="5" Grid.Column="3" Content="×" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Multiply}" />
          <Button Grid.Row="5" Grid.Column="4" Content="x²" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.XPower2}" />
          <Button Grid.Row="6" Grid.Column="0" Content="1" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.One}" />
          <Button Grid.Row="6" Grid.Column="1" Content="2" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Two}" />
          <Button Grid.Row="6" Grid.Column="2" Content="3" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Three}" />
          <Button Grid.Row="6" Grid.Column="3" Content="−" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Subtract}" />
          <Button Grid.Row="6" Grid.Column="4" Content="√" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Sqrt}" />
        </Grid>
      </DockPanel>

      <!-- Programmer panel -->
      <DockPanel IsVisible="{Binding IsProgrammer}" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <TextBlock Text="{Binding HexDisplayValue, StringFormat='HEX  {0}'}" FontFamily="Monospace" />
          <TextBlock Text="{Binding DecimalDisplayValue, StringFormat='DEC  {0}'}" FontFamily="Monospace" />
          <TextBlock Text="{Binding OctalDisplayValue, StringFormat='OCT  {0}'}" FontFamily="Monospace" />
          <TextBlock Text="{Binding BinaryDisplayValue, StringFormat='BIN  {0}'}" FontFamily="Monospace" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <RadioButton Content="HEX" GroupName="Radix" Name="RadixHex" Click="Radix_Click" Margin="0,0,8,0" />
            <RadioButton Content="DEC" GroupName="Radix" Name="RadixDec" Click="Radix_Click" Margin="0,0,8,0" />
            <RadioButton Content="OCT" GroupName="Radix" Name="RadixOct" Click="Radix_Click" Margin="0,0,8,0" />
            <RadioButton Content="BIN" GroupName="Radix" Name="RadixBin" Click="Radix_Click" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <RadioButton Content="QWORD" GroupName="Bits" Name="BitsQword" Click="Bits_Click" Margin="0,0,8,0" />
            <RadioButton Content="DWORD" GroupName="Bits" Name="BitsDword" Click="Bits_Click" Margin="0,0,8,0" />
            <RadioButton Content="WORD" GroupName="Bits" Name="BitsWord" Click="Bits_Click" Margin="0,0,8,0" />
            <RadioButton Content="BYTE" GroupName="Bits" Name="BitsByte" Click="Bits_Click" Margin="0,0,8,0" />
            <ToggleButton Content="Bit flip" IsChecked="{Binding IsBitFlipChecked, Mode=TwoWay}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer IsVisible="{Binding IsBitFlipChecked}" MaxHeight="120">
          <ItemsControl ItemsSource="{Binding BinaryDigits}" Name="BitFlipPanel">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Content="{Binding}" IsChecked="{Binding}" Click="Bit_Click" Width="36" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Grid IsVisible="{Binding AreProgrammerRadixOperatorsVisible}" RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*">
          <Button Grid.Row="0" Grid.Column="0" Content="A" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.A}" IsEnabled="{Binding AreHEXButtonsEnabled}" />
          <Button Grid.Row="0" Grid.Column="1" Content="B" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.B}" IsEnabled="{Binding AreHEXButtonsEnabled}" />
          <Button Grid.Row="0" Grid.Column="2" Content="C" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.C}" IsEnabled="{Binding AreHEXButtonsEnabled}" />
          <Button Grid.Row="0" Grid.Column="3" Content="D" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.D}" IsEnabled="{Binding AreHEXButtonsEnabled}" />
          <Button Grid.Row="0" Grid.Column="4" Content="E" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.E}" IsEnabled="{Binding AreHEXButtonsEnabled}" />
          <Button Grid.Row="1" Grid.Column="0" Content="F" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.F}" IsEnabled="{Binding AreHEXButtonsEnabled}" />
          <Button Grid.Row="1" Grid.Column="1" Content="(" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.OpenParenthesis}" />
          <Button Grid.Row="1" Grid.Column="2" Content=")" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.CloseParenthesis}" />
          <Button Grid.Row="1" Grid.Column="3" Content="Mod" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Mod}" />
          <Button Grid.Row="1" Grid.Column="4" Content="⌫" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Backspace}" />
          <Button Grid.Row="2" Grid.Column="0" Content="7" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Seven}" />
          <Button Grid.Row="2" Grid.Column="1" Content="8" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Eight}" />
          <Button Grid.Row="2" Grid.Column="2" Content="9" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Nine}" />
          <Button Grid.Row="2" Grid.Column="3" Content="÷" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Divide}" />
          <Button Grid.Row="2" Grid.Column="4" Content="And" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.And}" />
          <Button Grid.Row="3" Grid.Column="0" Content="4" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Four}" />
          <Button Grid.Row="3" Grid.Column="1" Content="5" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Five}" />
          <Button Grid.Row="3" Grid.Column="2" Content="6" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Six}" />
          <Button Grid.Row="3" Grid.Column="3" Content="×" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Multiply}" />
          <Button Grid.Row="3" Grid.Column="4" Content="Or" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Or}" />
          <Button Grid.Row="4" Grid.Column="0" Content="1" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.One}" />
          <Button Grid.Row="4" Grid.Column="1" Content="2" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Two}" />
          <Button Grid.Row="4" Grid.Column="2" Content="3" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Three}" />
          <Button Grid.Row="4" Grid.Column="3" Content="−" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Subtract}" />
          <Button Grid.Row="4" Grid.Column="4" Content="Xor" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Xor}" />
          <Button Grid.Row="5" Grid.Column="0" Content="±" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Negate}" />
          <Button Grid.Row="5" Grid.Column="1" Content="0" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Zero}" />
          <Button Grid.Row="5" Grid.Column="2" Content="=" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Equals}" />
          <Button Grid.Row="5" Grid.Column="3" Content="+" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Add}" />
          <Button Grid.Row="5" Grid.Column="4" Content="Not" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Not}" />
        </Grid>
      </DockPanel>
    </DockPanel>
    <!-- Date calculator -->
    <StackPanel Name="DatePanel" IsVisible="False" Margin="8" Width="420" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton Content="Difference" GroupName="DateMode" Name="DateModeDiff" Click="DateMode_Click" Margin="0,0,12,0" />
        <RadioButton Content="Add / subtract" GroupName="DateMode" Name="DateModeAddSub" Click="DateMode_Click" />
      </StackPanel>
      <StackPanel Name="DateDiffStack">
        <TextBlock Text="From" Opacity="0.7" />
        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Margin="0,0,0,8" />
        <TextBlock Text="To" Opacity="0.7" />
        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Margin="0,0,0,8" />
        <TextBlock Text="{Binding StrDateDiffResult}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding StrDateDiffResultInDays}" FontSize="16" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Name="DateAddSubStack" IsVisible="False">
        <TextBlock Text="From" Opacity="0.7" />
        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton Content="Add" GroupName="DateAddSub" Name="DateAdd" Click="DateAddSub_Click" Margin="0,0,12,0" />
          <RadioButton Content="Subtract" GroupName="DateAddSub" Name="DateSub" Click="DateAddSub_Click" />
        </StackPanel>
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Years" VerticalAlignment="Center" Margin="0,0,8,4" />
          <TextBox Grid.Row="0" Grid.Column="1" Name="YearsBox" TextChanged="OffsetBox_Changed" Margin="0,0,0,4" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Months" VerticalAlignment="Center" Margin="0,0,8,4" />
          <TextBox Grid.Row="1" Grid.Column="1" Name="MonthsBox" TextChanged="OffsetBox_Changed" Margin="0,0,0,4" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Days" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Grid.Row="2" Grid.Column="1" Name="DaysBox" TextChanged="OffsetBox_Changed" />
        </Grid>
        <TextBlock Text="{Binding StrDateResult}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
    <!-- Unit converter -->
    <DockPanel Name="ConverterPanel" IsVisible="False" LastChildFill="True" Margin="8">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock Text="Converting..." Opacity="0.7" IsVisible="{Binding IsCurrencyLoadingVisible}" />
        <TextBlock Text="{Binding CurrencyTimestamp}" Opacity="0.7" />
        <TextBlock Text="Check your connection and try again." Foreground="Red"
                   IsVisible="{Binding CurrencyDataLoadFailed}" />
        <TextBlock Text="Rates are more than a week old." Foreground="Orange"
                   IsVisible="{Binding CurrencyDataIsWeekOld}" />
      </StackPanel>
      <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,*" Margin="0,0,0,8">
        <ComboBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit1, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="0,0,4,4">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Row="0" Grid.Column="1" Content="⇄" Command="{Binding SwitchActiveCommand}" Margin="4,0,4,4" />
        <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit2, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="4,0,0,4">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Value1}" FontSize="28" TextAlignment="Right"
                 IsReadOnly="True" GotFocus="ConverterValue_GotFocus" Name="ConverterValue1" Margin="0,0,4,0" />
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Value2}" FontSize="28" TextAlignment="Right"
                 IsReadOnly="True" GotFocus="ConverterValue_GotFocus" Name="ConverterValue2" Margin="4,0,0,0" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding CurrencySymbol1}" Opacity="0.7"
                   IsVisible="{Binding CurrencySymbolVisibility}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CurrencySymbol2}" Opacity="0.7"
                   IsVisible="{Binding CurrencySymbolVisibility}" />
      </Grid>
      <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding SupplementaryResults}" MaxHeight="140" Margin="0,0,0,8">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Value}" FontWeight="Bold" Margin="0,0,8,0" />
              <TextBlock Text="{Binding Unit.Name}" Opacity="0.7" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*">
        <Button Grid.Row="0" Grid.Column="0" Content="C" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Clear}" />
        <Button Grid.Row="0" Grid.Column="1" Content="⌫" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Backspace}" />
        <Button Grid.Row="0" Grid.Column="2" Content="⇄" Command="{Binding SwitchActiveCommand}" />
        <Button Grid.Row="1" Grid.Column="0" Content="7" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Seven}" />
        <Button Grid.Row="1" Grid.Column="1" Content="8" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Eight}" />
        <Button Grid.Row="1" Grid.Column="2" Content="9" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Nine}" />
        <Button Grid.Row="2" Grid.Column="0" Content="4" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Four}" />
        <Button Grid.Row="2" Grid.Column="1" Content="5" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Five}" />
        <Button Grid.Row="2" Grid.Column="2" Content="6" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Six}" />
        <Button Grid.Row="3" Grid.Column="0" Content="1" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.One}" />
        <Button Grid.Row="3" Grid.Column="1" Content="2" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Two}" />
        <Button Grid.Row="3" Grid.Column="2" Content="3" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Three}" />
        <Button Grid.Row="4" Grid.Column="0" Content="±" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Negate}" />
        <Button Grid.Row="4" Grid.Column="1" Content="0" Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Zero}" />
        <Button Grid.Row="4" Grid.Column="2" Content="." Command="{Binding ButtonPressedCommand}" CommandParameter="{x:Static common:NumbersAndOperatorsEnum.Decimal}" />
      </Grid>
    </DockPanel>
  </DockPanel>
</Window>
