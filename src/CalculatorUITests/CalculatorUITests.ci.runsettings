<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector uri="datacollector://microsoft/VideoRecorder/1.0" assemblyQualifiedName="Microsoft.VisualStudio.TestTools.DataCollection.VideoRecorder.VideoRecorderDataCollector, Microsoft.VisualStudio.TestTools.DataCollection.VideoRecorder, Version=15.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" friendlyName="Screen and Voice Recorder">
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
    <TestRunParameters>
        <Parameter Name="AppId" Value="Microsoft.WindowsCalculator.Dev_8wekyb3d8bbwe!App" />
        <Parameter Name="CurrencyWith3FractionalDigits" Value="Test Fractional Digits - Test Fractional Digits" />
        <Parameter Name="CurrencyWithoutFractionalDigits" Value="Test No Fractional Digits - Test No Fractional Digits" />
        <!-- Two distinct currencies that both use the default two fraction digits. The converter
             prevents both chips from showing the same unit, so tests use a known pair instead. -->
        <Parameter Name="BaselineCurrencyFrom" Value="Mars - The Martian Dollar" />
        <Parameter Name="BaselineCurrencyTo" Value="Moon - Moon Bucks" />
    </TestRunParameters>
</RunSettings>
